---
/** Link styled as a button (look in ./button.ts). */
import { buttonClass, type ButtonVariant } from './button';

interface Props {
  href: string;
  variant?: ButtonVariant;
  size?: 'md' | 'lg';
  class?: string;
  [attr: string]: unknown;
}
const { href, variant = 'primary', size = 'lg', class: className, ...rest } = Astro.props;
---
<a href={href} class:list={[buttonClass(variant, size), className]} {...rest}>
  <slot />
</a>
