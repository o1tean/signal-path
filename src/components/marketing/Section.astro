---
/** Page section: 1200px container, 16/24px gutters, 56/96/112px rhythm, optional eyebrow, heading and intro.
    `id` is the copy section id from docs/v2/copy/*.md. */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  class?: string;
  /** muted band behind the whole section */
  tone?: 'plain' | 'muted';
  align?: 'start' | 'center';
}
const { id, eyebrow, title, intro, class: className, tone = 'plain', align = 'start' } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---
<section
  id={id}
  data-section={id}
  aria-labelledby={title ? headingId : undefined}
  class:list={['scroll-mt-20', tone === 'muted' && 'border-y border-border bg-card py-6 md:py-10']}
>
  <div class:list={['mx-auto w-full max-w-[75rem] px-4 py-9 sm:px-6 md:py-12 lg:py-14', className]}>
    {
      (eyebrow || title || intro) && (
        <header class:list={['mb-10 max-w-2xl md:mb-14', align === 'center' && 'mx-auto text-center']}>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && (
            <h2 id={headingId} class="mt-3 text-[1.75rem] leading-[1.12] tracking-[-0.025em] md:text-[2.5rem]">
              {title}
            </h2>
          )}
          {intro && <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{intro}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
