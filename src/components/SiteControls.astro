---
/** Theme and decorative-motion toggles. Both persist under the legacy localStorage keys. */
---
<div class="flex items-center gap-1">
  <button type="button" data-theme-toggle class="inline-flex size-11 items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Switch colour theme" title="Switch colour theme">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"></path></svg>
  </button>
  <button type="button" data-motion-toggle aria-pressed="false" class="inline-flex size-11 items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground disabled:opacity-50" aria-label="Pause decorative animations" title="Pause decorative animations">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="currentColor" data-icon-pause><rect x="7" y="6" width="3.5" height="12" rx="1"></rect><rect x="13.5" y="6" width="3.5" height="12" rx="1"></rect></svg>
    <svg aria-hidden="true" viewBox="0 0 24 24" class="hidden size-5" fill="currentColor" data-icon-play><path d="M8 5.5v13l11-6.5Z"></path></svg>
  </button>
</div>
<script>
  import { $motion, $theme, effectiveTheme, prefersReducedMotion, setMotion, toggleTheme } from '@/lib/learner';

  function sync() {
    const reduced = prefersReducedMotion();
    const paused = $motion.get() === 'paused' || reduced;
    document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((b) => {
      const label = reduced
        ? 'Animations paused by your system setting'
        : paused
          ? 'Resume decorative animations'
          : 'Pause decorative animations';
      b.setAttribute('aria-pressed', String(paused));
      b.setAttribute('aria-label', label);
      b.title = label;
      b.disabled = reduced;
      b.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused);
      b.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused);
    });
  }
  document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', toggleTheme));
  document.querySelectorAll('[data-motion-toggle]').forEach((b) =>
    b.addEventListener('click', () => setMotion($motion.get() === 'paused' ? 'playing' : 'paused')),
  );
  $motion.subscribe(sync);
  // label names the theme the button switches to (docs/v2/copy/chrome.md#navbar)
  $theme.subscribe(() => {
    const label = effectiveTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-label', label);
      b.title = label;
    });
  });
  matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', () => setMotion($motion.get()));
</script>
