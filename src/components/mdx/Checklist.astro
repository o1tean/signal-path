---
/** A static checklist. Pass `items`, or a Markdown list as children. */
interface Props {
  title?: string;
  items?: string[];
}
const { title, items } = Astro.props;
---
<div class="checklist my-6 rounded-lg border border-border bg-card p-4">
  {title && <p class="m-0 mb-2 font-semibold">{title}</p>}
  {
    items ? (
      <ul class="m-0 list-none space-y-2 p-0">
        {items.map((item) => (
          <li class="flex gap-2.5 pl-0">
            <span class="mt-1 size-4 shrink-0 rounded-sm border-2 border-primary/60" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    ) : (
      <slot />
    )
  }
</div>
<style>
  .checklist :global(ul) {
    list-style: none;
    padding-left: 0;
    margin-bottom: 0;
  }
  .checklist :global(li) {
    position: relative;
    padding-left: 1.75rem;
  }
  .checklist :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 1rem;
    height: 1rem;
    border-radius: 0.25rem;
    border: 2px solid color-mix(in oklab, var(--primary) 60%, transparent);
  }
</style>
