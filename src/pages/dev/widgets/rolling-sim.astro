---
import Base from '@/layouts/Base.astro';
import Widget from '@/components/mdx/Widget.astro';

if (!import.meta.env.DEV) return new Response(null, { status: 404 });
export const prerender = false;
---
<Base title="Dev: rolling-sim" description="Development page for the rolling-sim widget." index={false}>
  <main class="mx-auto max-w-3xl space-y-8 px-4 py-8">
    <h1 class="text-2xl font-semibold">rolling-sim</h1>
    <section id="full"><Widget name="rolling-sim" /></section>
    <section id="compact"><Widget name="rolling-sim" opts={{ mode: 'compact' }} /></section>
  </main>
</Base>
