---
import Base from '@/layouts/Base.astro';
import Widget from '@/components/mdx/Widget.astro';

if (!import.meta.env.DEV) return new Response(null, { status: 404 });
export const prerender = false;
---
<Base title="Dev: tune-in" description="Development page for the tune-in widget." index={false}>
  <main class="mx-auto max-w-xl space-y-8 px-4 py-8">
    <h1 class="text-2xl font-semibold">tune-in</h1>
    <section id="full"><Widget name="tune-in" /></section>
    <section id="compact"><Widget name="tune-in" opts={{ mode: 'compact' }} /></section>
  </main>
</Base>
