---
import Base from '@/layouts/Base.astro';
import Widget from '@/components/mdx/Widget.astro';

if (!import.meta.env.DEV) return new Response(null, { status: 404 });
export const prerender = false;
---
<Base title="Dev: signal-atlas" description="Development page for the signal-atlas widget." index={false}>
  <main class="mx-auto max-w-3xl space-y-8 px-4 py-8">
    <h1 class="text-2xl font-semibold">signal-atlas</h1>
    <section id="full"><Widget name="signal-atlas" /></section>
    <section id="compact"><Widget name="signal-atlas" opts={{ mode: 'compact' }} /></section>
  </main>
</Base>
