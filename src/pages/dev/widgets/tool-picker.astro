---
import Base from '@/layouts/Base.astro';
import Widget from '@/components/mdx/Widget.astro';

if (!import.meta.env.DEV) return new Response(null, { status: 404 });
export const prerender = false;
---
<Base title="Dev: tool-picker" description="Development page for the tool-picker widget." index={false}>
  <main class="mx-auto max-w-xl space-y-8 px-4 py-8">
    <h1 class="text-2xl font-semibold">tool-picker</h1>
    <section id="full"><Widget name="tool-picker" /></section>
    <section id="compact"><Widget name="tool-picker" opts={{ mode: 'compact' }} /></section>
  </main>
</Base>
