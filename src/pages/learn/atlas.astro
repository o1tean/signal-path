---
import Learn from '@/layouts/Learn.astro';
import Widget from '@/components/mdx/Widget.astro';
---
<Learn title="Signal atlas" description="Your signal atlas: a log of every device you have tested, with frequency, modulation, protocol and code type. Stored in this browser.">
  <div class="mx-auto max-w-4xl lg:ml-0 lg:pl-4">
    <p class="eyebrow">Signal atlas</p>
    <h1 class="mt-3">Every device you have tested, in one table.</h1>
    <p class="lede mt-4">Add a row each time you identify a device: its frequency, modulation, protocol and code type. Module 10 turns this log into your foundation project.</p>
    <Widget name="signal-atlas" />
  </div>
</Learn>
