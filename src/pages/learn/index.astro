---
/* On-demand: the lede depends on the session. */
import Learn from '@/layouts/Learn.astro';
import ResumeLink from '@/components/learn/ResumeLink';
import BadgeGrid from '@/components/learn/BadgeGrid';
import StageTimeline from '@/components/marketing/StageTimeline.astro';
import { lessonTitles } from '@/lib/lessons';

const titles = await lessonTitles();
---
<Learn title="Your dashboard" description="Your Signal Path progress: the next lesson, the six stages and the badges you have earned.">
  <div class="mx-auto max-w-4xl lg:ml-0 lg:pl-4">
    <p class="eyebrow">Dashboard</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">Pick up where you left off.</h1>
    {
      Astro.locals.user ? (
        <p class="lede mt-4">Progress is saved in this browser and synced to your <a href="/account#sync" class="text-primary underline underline-offset-2">account</a>.</p>
      ) : (
        <p class="lede mt-4">Progress is saved in this browser. <a href="/login?next=%2Flearn" class="text-primary underline underline-offset-2">Sign in</a> to keep it on every device, or back it up from the <a href="/learn/notebook#backup" class="text-primary underline underline-offset-2">notebook</a>.</p>
      )
    }
    <div class="mt-6">
      <ResumeLink client:only="react" titles={titles} />
    </div>

    <section aria-labelledby="stages-title" class="mt-14">
      <h2 id="stages-title" class="text-2xl">Stages</h2>
      <div class="mt-6">
        <StageTimeline detailed />
      </div>
    </section>

    <section aria-labelledby="badges-title" class="mt-14">
      <h2 id="badges-title" class="text-2xl">Badges</h2>
      <div class="mt-4">
        <BadgeGrid client:only="react" />
      </div>
    </section>
  </div>
</Learn>
