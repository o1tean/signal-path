---
/* Home. Copy: docs/v2/copy/home.md (section ids kept as HTML ids). Instructor and testimonials stay hidden until real. */
import Marketing from '@/layouts/Marketing.astro';
import Hero from '@/components/marketing/Hero.astro';
import HowItWorks from '@/components/marketing/HowItWorks.astro';
import Section from '@/components/marketing/Section.astro';
import StageTimeline from '@/components/marketing/StageTimeline.astro';
import ToolShowcase from '@/components/marketing/ToolShowcase.astro';
import PricingPreview from '@/components/marketing/PricingPreview.astro';
import Faq from '@/components/marketing/Faq.astro';
import Cta from '@/components/marketing/Cta.astro';
import LinkButton from '@/components/marketing/LinkButton.astro';
import { courseJsonLd } from '@/components/marketing/schema';
import { facts } from '@/components/marketing/site';
import { homeFaqIds } from '@/data/faq';

export const prerender = true;

const proof = [
  { n: facts.lessons, rest: `lessons in ${facts.stages} stages` },
  { n: facts.weeks, rest: 'weeks at 2–4 hours a week' },
  { n: facts.questions, rest: 'quiz questions, each with an explanation' },
  { n: facts.tools, rest: 'browser tools running on synthetic signals' },
];
const maybes = [
  { tag: '868.35 ≠ 433.92 MHz', text: 'Maybe the remote transmits at 868.35 MHz and you were listening at 433.92.' },
  { tag: 'FSK ≠ AM650', text: 'Maybe it uses FSK and the preset was AM650.' },
  { tag: 'counter +1', text: 'Maybe it uses a rolling code, so the copy you saved will be accepted once at most.' },
];
---
<Marketing
  title="The 12-week Flipper Zero course"
  description={`A 12-week Flipper Zero course: ${facts.lessons} lessons, ${facts.tools} browser tools and ${facts.questions} quiz questions, with labs on equipment you own. The first two lessons are free.`}
  jsonLd={courseJsonLd(Astro.site)}
>
  <Hero />

  <section id="proof-strip" data-section="proof-strip" aria-label="The course in numbers" class="border-y border-border bg-card">
    <dl class="mx-auto grid w-full max-w-[75rem] grid-cols-2 px-4 sm:px-6 lg:grid-cols-4">
      {
        proof.map((p, i) => (
          <div class:list={['flex flex-col-reverse justify-end gap-1 py-6 md:py-8', i % 2 === 1 && 'border-l border-border pl-4 sm:pl-6', i >= 2 && 'border-t border-border lg:border-t-0', i === 2 && 'lg:border-l lg:pl-6']}>
            <dt class="max-w-[16rem] pr-3 text-sm leading-snug text-muted-foreground">{p.rest}</dt>
            <dd class="m-0 text-[2rem] leading-none font-semibold tracking-[-0.03em] tabular-nums md:text-[2.5rem]">{p.n}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Section id="problem">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16">
      <header>
        <p class="eyebrow">Where owners get stuck</p>
        <h2 id="problem-title" class="mt-3 text-[1.75rem] leading-[1.12] tracking-[-0.025em] md:text-[2.5rem]">The capture failed, and the tutorial only showed which button to press.</h2>
      </header>
      <div>
        <ul class="divide-y divide-border border-y border-border">
          {
            maybes.map((m) => (
              <li class="grid gap-2 py-5 sm:grid-cols-[10.5rem_1fr] sm:gap-6">
                <span class="self-start justify-self-start rounded-md bg-scope-bg px-2.5 py-1 font-mono text-xs whitespace-nowrap text-scope-peak tabular-nums" aria-hidden="true">{m.tag}</span>
                <p class="text-lg leading-snug">{m.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 max-w-[60ch] leading-relaxed text-muted-foreground">Many forum answers say to flash a different firmware. Each of these failures has a cause you can measure on your own devices.</p>
      </div>
    </div>
  </Section>

  <HowItWorks />

  <ToolShowcase />

  <Section id="path" eyebrow={`The ${facts.weeks}-week path`} title="Six stages, from first setup to a project someone else can repeat." intro="Plan for 2–4 hours a week. The weeks are a suggested order, and your progress is saved if you take longer.">
    <StageTimeline />
    <div class="mt-10">
      <LinkButton href="/course" variant="secondary">See every lesson</LinkButton>
    </div>
  </Section>

  <section class="mx-auto w-full max-w-[75rem] px-4 sm:px-6" aria-label="The Wi-Fi extension and the lab rules">
    <div class="grid gap-4 lg:grid-cols-2">
      <article id="wifi" data-section="wifi" aria-labelledby="wifi-title" class="flex flex-col overflow-hidden rounded-[1.25rem] border border-border bg-card">
        <div class="bg-scope-bg px-6 pt-6">
          <img src="/images/wifi-board.svg" alt="Concept illustration of the official Wi-Fi Devboard (ESP32-S2)" width="600" height="460" loading="lazy" decoding="async" class="mx-auto h-auto max-h-64 w-auto" />
        </div>
        <div class="flex flex-1 flex-col p-6 sm:p-8">
          <p class="eyebrow">Optional extension, Module 18</p>
          <h2 id="wifi-title" class="mt-3 text-2xl tracking-[-0.02em] md:text-[1.75rem]">Add the official Wi-Fi Devboard when you have one.</h2>
          <p class="mt-3 font-medium">One lesson on the ESP32-S2 board, taken after Modules 8, 12 and 15.</p>
          <p class="mt-3 flex-1 leading-relaxed text-muted-foreground">You flash the board's firmware and debug your own Flipper app over the Black Magic probe. Measurements run on a 2.4 GHz access point you own. If a flash fails, the recovery worksheet takes the board back to a known firmware. Allow 3–4 extra sessions.</p>
          <a href="/course#stage-wifi" class="mt-6 inline-flex min-h-11 items-center gap-1.5 self-start font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">What Module 18 covers <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article id="lab-rules" data-section="lab-rules" aria-labelledby="lab-rules-title" class="flex flex-col rounded-[1.25rem] border border-border bg-card p-6 sm:p-8">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-9 text-primary" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 4h6M10 4v5.5L5 18a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-8.5V4" />
          <path d="M7.5 14h9" />
        </svg>
        <p class="eyebrow mt-6">Scope and sources</p>
        <h2 id="lab-rules-title" class="mt-3 text-2xl tracking-[-0.02em] md:text-[1.75rem]">Every lab runs on equipment you own or have written permission to test.</h2>
        <p class="mt-3 font-medium">The course teaches how signals and access systems work, and how people defend them.</p>
        <p class="mt-3 flex-1 leading-relaxed text-muted-foreground">Lessons that transmit say so at the top, next to the time and gear. Before your first hardware session, the Romanian lab guide takes you through three checks. They cover who can authorise the test, which radio conditions apply and what the test could affect. Technical claims link to primary sources, such as the Flipper documentation, Microchip's HCS301 datasheet and ANCOM's radio interfaces. Each lesson shows the date we last checked its sources. Official firmware is enough for every lesson.</p>
        <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
          <LinkButton href="/romania-lab-guide" variant="secondary" size="md">Read the Romanian lab guide</LinkButton>
          <a href="/sources" class="inline-flex min-h-11 items-center font-medium underline decoration-border underline-offset-4 hover:decoration-primary">See the sources</a>
        </div>
      </article>
    </div>
  </section>

  <PricingPreview />

  <Section id="faq" title="Questions">
    <Faq ids={homeFaqIds} />
    <p class="mt-6 text-muted-foreground">More answers on the <a href="/pricing#faq" class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 hover:decoration-primary">pricing page</a>.</p>
  </Section>

  <Cta title="Start with Module 0 tonight." body="Modules 0 and 1 are free and start in the browser. Bring the Flipper when the first hardware lab asks for it." microcopy="Free. No card required.">
    <LinkButton href="/learn/00-setup">Start the free starter</LinkButton>
  </Cta>
</Marketing>
