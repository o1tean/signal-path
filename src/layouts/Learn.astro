---
/** Learner area shell: slim header, stage/lesson sidebar (sheet on small screens), main column, optional right rail. */
import Base, { type BaseProps } from './Base.astro';
import SiteControls from '@/components/SiteControls.astro';
import LearnSidebar from '@/components/learn/LearnSidebar.astro';
import LearnNavSheet from '@/components/learn/LearnNavSheet';
import ProgressRing from '@/components/learn/ProgressRing';
import ResumeLink from '@/components/learn/ResumeLink';
import AuthButtons from '@/components/learn/AuthButtons.astro';
import { getStages, lessonTitles } from '@/lib/lessons';

interface Props extends BaseProps {
  /** current module id, highlighted in the sidebar */
  current?: string;
}
const { current, index = false, ...rest } = Astro.props;
const hasRail = Astro.slots.has('rail');
const stages = await getStages();
const titles = await lessonTitles();
---
<Base {...rest} index={index}>
  <slot name="head" slot="head" />
  <header class="sticky top-0 z-40 border-b border-border/70 bg-background/85 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-[90rem] items-center gap-2 px-4 sm:gap-3 sm:px-6">
      <div class="lg:hidden">
        <LearnNavSheet client:media="(max-width: 1023px)" current={current} stages={stages} />
      </div>
      <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 font-semibold" aria-label="Signal Path home">
        <img src="/images/signal-path-logo.png" alt="" width="24" height="24" class="size-6" />
        <span class="hidden sm:inline">Signal Path</span>
      </a>
      <span class="hidden text-border sm:inline" aria-hidden="true">/</span>
      <a href="/learn" class="hidden min-h-11 content-center text-sm text-muted-foreground hover:text-foreground sm:block">My course</a>
      <nav aria-label="Learner tools" class="ml-auto flex min-w-0 items-center gap-1 text-sm">
        <a href="/learn/notebook" class="hidden min-h-11 content-center rounded-full px-3 text-muted-foreground hover:text-foreground sm:block">Notebook</a>
        <a href="/learn/quiz" class="hidden min-h-11 content-center rounded-full px-3 text-muted-foreground hover:text-foreground sm:block">Quiz</a>
        <AuthButtons />
        <SiteControls />
      </nav>
    </div>
  </header>
  <div class:list={['mx-auto grid max-w-[90rem] gap-8 px-4 sm:px-6 lg:grid-cols-[17rem_minmax(0,1fr)]', hasRail && 'xl:grid-cols-[17rem_minmax(0,1fr)_14rem]']}>
    <aside class="hidden lg:block" aria-label="Course navigation">
      <div class="sticky top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto py-6 pr-2">
        <div class="mb-6 space-y-4 rounded-card border border-border bg-card p-4">
          <ProgressRing client:only="react" />
          <ResumeLink client:only="react" titles={titles} className="w-full justify-between text-xs" />
        </div>
        <LearnSidebar current={current} />
      </div>
    </aside>
    <main id="main-content" tabindex="-1" class="min-w-0 py-8 outline-none lg:py-10">
      <slot />
    </main>
    {
      hasRail && (
        <aside class="hidden xl:block" aria-label="On this page">
          <div class="sticky top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto py-10">
            <slot name="rail" />
          </div>
        </aside>
      )
    }
  </div>
</Base>
