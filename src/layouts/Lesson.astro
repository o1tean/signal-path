---
/** One lesson: header, body (or paywall), mark-complete, pager, and a TOC from the rendered headings. */
import type { MarkdownHeading } from 'astro';
import type { LessonFrontmatter } from '@/content.config';
import Learn from './Learn.astro';
import { stages } from '@/data/course';
import { getLessons } from '@/lib/lessons';
import LessonToc from '@/components/learn/LessonToc.astro';
import PrevNext from '@/components/learn/PrevNext.astro';
import MarkComplete from '@/components/learn/MarkComplete';
import LessonLcd from '@/components/learn/LessonLcd.astro';

interface Props {
  lesson: LessonFrontmatter;
  headings: MarkdownHeading[];
  /** true when the body is replaced by the paywall */
  locked?: boolean;
}
const { lesson, headings, locked = false } = Astro.props;
const lessons = await getLessons();
const i = lessons.findIndex((m) => m.id === lesson.id);
const prev = lessons[i - 1];
const next = lessons[i + 1];
const stage = stages.find((s) => s.id === lesson.stage);
const transmitLabel = {
  none: 'Receive only',
  'own-device': 'Transmits to your own receiver',
  'lab-only': 'Transmits in your lab setup only',
}[lesson.transmits];
const reviewed = new Date(`${lesson.reviewed}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Learn title={`Module ${lesson.number}: ${lesson.title}`} description={lesson.description} current={lesson.id} ogType="article" index={!locked}>
  <article class="mx-auto max-w-3xl lg:ml-0 lg:pl-4">
    <header class="flex items-start gap-6 border-b border-border pb-8">
      <div class="min-w-0 flex-1">
        <p class="eyebrow">Module {lesson.number} · {stage?.title} · {lesson.week}</p>
        <h1 class="mt-3">{lesson.title}</h1>
        <p class="lede mt-4 max-w-[60ch]">{lesson.description}</p>
        <ul class="mt-5 flex flex-wrap gap-2 text-sm" aria-label="Lesson facts">
          <li class="rounded-full border border-border px-3 py-1"><b>{lesson.minutes} min</b></li>
          <li class="rounded-full border border-border px-3 py-1"><b>{transmitLabel}</b></li>
          {lesson.access === 'free' && <li class="rounded-full border border-border bg-muted px-3 py-1"><b>Free lesson</b></li>}
        </ul>
        <p class="mt-3 mb-0 max-w-[60ch] text-sm text-muted-foreground">Gear: {lesson.gear.join(', ')}</p>
      </div>
      <LessonLcd moduleId={lesson.id} number={lesson.number} title={lesson.title} week={lesson.week} />
    </header>

    {locked ? <slot name="paywall" /> : <div class="lesson-prose mt-10"><slot /></div>}

    {!locked && <MarkComplete client:only="react" moduleId={lesson.id} />}
    {
      !locked && (
        <p class="text-sm">
          <a class="font-medium text-primary underline underline-offset-2" href={`/learn/notebook?module=${lesson.id}`}>Record this module in your notebook</a>
        </p>
      )
    }
    {
      !locked && lesson.sources.length > 0 && (
        <section aria-labelledby="lesson-sources" class="mt-10 border-t border-border pt-6">
          <h2 id="lesson-sources" class="text-lg">Sources for this lesson</h2>
          <ul class="mt-3 grid gap-1 text-sm">
            {lesson.sources.map((src) => (
              <li>
                <a href={src.url} class="inline-flex min-h-11 items-center text-accent-foreground underline underline-offset-2" rel="noopener">
                  {src.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <p class="mt-6 text-xs text-muted-foreground">Sources reviewed {reviewed}.</p>
    <PrevNext prev={prev} next={next} />
  </article>
  {!locked && <LessonToc slot="rail" headings={headings} next={next} />}
</Learn>
