# Copy to .env (gitignored) and fill in. Production values go in the host's environment, never in the repo.
# Local development: `npx supabase start` prints the local URL and keys; see docs/v2/deploy.md.

# Public base URL used for canonical links, the sitemap, auth email links and Stripe redirects (no trailing slash)
PUBLIC_SITE_URL=https://signalpath.example

# Supabase project URL. Local stack: http://127.0.0.1:54321. Production: https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...), server only: Stripe webhook writes. Never expose to the client.
SUPABASE_SECRET_KEY=
# Set to 1 to show "Continue with Google" on /login (enable the Google provider in Supabase first)
PUBLIC_AUTH_GOOGLE=0

# Stripe secret key (sk_test_... in development). Empty = /api/checkout answers 503 "Checkout is not configured yet."
STRIPE_SECRET_KEY=
# Stripe webhook signing secret for /api/stripe/webhook (whsec_...; `stripe listen` prints one for local testing)
STRIPE_WEBHOOK_SECRET=
# Stripe price id for Signal Path Complete (price_...)
STRIPE_PRICE_COMPLETE=

# Set to 1 to read paid lessons without an entitlement; honoured by `astro dev` only, ignored in builds
SP_DEV_BYPASS=0

# Tests: the Playwright sign-in specs create a local learner on first run and keep its generated credentials in
# .e2e-user.json (gitignored). Optional override for the Mailpit inbox of the local stack:
# E2E_MAILPIT_URL=http://127.0.0.1:54324
